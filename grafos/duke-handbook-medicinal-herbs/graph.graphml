<node id="hierba:chelone-glabra-l-balmony"><data key="n_label">Balmony, Turtlehead</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">BALMONY, TURTLEHEAD</data><data key="n_page">52</data><data key="n_scientific">Chelone glabra L.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">1 drachm leaf 3 ×/day (CEB); 0.5–1 g powdered herb (PNC); 2–4 ml liquid extract (PNC).</data><data key="n_downsides">Class 1 (AHP). Food Plant (DEM). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD).</data></node>
<node id="act:antidepressant"><data key="n_label">Antidepressant</data><data key="n_type">Actividad</data><data key="n_description">Citada en 30 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
