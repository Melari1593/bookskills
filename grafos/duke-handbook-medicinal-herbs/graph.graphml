<node id="ind:cystic-fibrosis"><data key="n_label">Cystic Fibrosis</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:simarouba-glauca-dc-dysentery-bark"><data key="n_label">Dysentery Bark</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DYSENTERY BARK</data><data key="n_page">262</data><data key="n_scientific">Simarouba glauca DC.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">Mix 30 g powdered leaf with 65 ml coconut oil, gives enough for 10-day treatment (TRA); handful of bark in 3 cups water boiled 10 minutes as tea or bath (AAB); 15–60 drops 3 ×/day alcoholic tincture (steeped 15 days) for ameba.</data></node>
<node id="act:locusticide"><data key="n_label">Locusticide</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
