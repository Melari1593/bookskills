<node id="hierba:cucumis-melo-l-melon"><data key="n_label">Melon, Cantaloupe</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">MELON, CANTALOUPE</data><data key="n_page">498</data><data key="n_scientific">Cucumis melo L.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">Biblical food farmacy. All things in moderation (JAD).</data></node>
