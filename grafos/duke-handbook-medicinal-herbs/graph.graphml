<node id="hierba:cornus-officinalis-siebold-zucc-asiatic-dogwood"><data key="n_label">Asiatic Dogwood, Japanese Cornel</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">ASIATIC DOGWOOD, JAPANESE CORNEL</data><data key="n_page">43</data><data key="n_scientific">Cornus officinalis Siebold &amp; Zucc.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">3–12 g fruit (PH2).</data><data key="n_downsides">Class 2d. Contraindicated in those with difficult or painful urination (AHP). “Health hazards not known with proper therapeutic dosages” (PH2).</data></node>
<node id="act:leukocytogenic"><data key="n_label">Leukocytogenic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 8 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:saraca-indica-l-asoka"><data key="n_label">Asoka</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Saraca asoca (Roxb.) De Wilde.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">ASOKA</data><data key="n_page">43</data><data key="n_scientific">Saraca indica L.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">1–3 g powdered bark (KAP); 28–112 ml bark decoction (KAP).</data><data key="n_downsides">Not covered (AHP; KOM; PH2). Contains an androgenic ketosterol. Bark uteroactive, stimulating endometrium and ovarian tissue (KAP). Bark contains a powerful oxytocic phenolic glycoside P2. Alcoholic bark extracts antibacterial. Aqueous extract active against carcinoma and sarcoma.</data></node>
<node id="act:androgenic"><data key="n_label">Androgenic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
