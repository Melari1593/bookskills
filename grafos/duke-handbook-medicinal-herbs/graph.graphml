<node id="ind:trismus"><data key="n_label">Trismus</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:hyptis-verticillata-jacq-john-charles"><data key="n_label">John Charles</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">JOHN CHARLES</data><data key="n_page">427</data><data key="n_scientific">Hyptis verticillata Jacq.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">Handful of root and/or leaf boiled 10 minutes in 3 cups water, drink 1 cup warm before each meal (AAB).</data></node>
<node id="act:pediculifuge"><data key="n_label">Pediculifuge</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:simmondsia-chinensis-jojoba"><data key="n_label">Jojoba</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">JOJOBA</data><data key="n_page">428</data><data key="n_scientific">Simmondsia chinensis (Link.) C. K. Schneid.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">Topical.</data><data key="n_downsides">Not covered (AHP). None known at proper dose (PHR). Wax is unsuitable for internal use (PH2).“Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD).</data></node>
<node id="act:cosmetic"><data key="n_label">Cosmetic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:ziziphus-jujuba-mill-jujube"><data key="n_label">Jujube, Common Jujube, Chinese Date</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">JUJUBE, COMMON JUJUBE, CHINESE DATE</data><data key="n_page">429</data><data key="n_scientific">Ziziphus jujuba Mill.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">Food farmacy. 5–10 g fruit (APA); 6–15 g fruit (FAY); 2–8 g dry seed/day or 4–16 ml fluid extract (1:2) (KEB).</data><data key="n_downsides">Class 1, 2b. Emmenagogue and uterotonic (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD). No significant toxic effects (LAF). Not covered (KOM).</data></node>
