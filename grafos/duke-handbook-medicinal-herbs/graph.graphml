<node id="ind:dysplasia"><data key="n_label">Dysplasia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:flourosis"><data key="n_label">Flourosis</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:hyperproteinemia"><data key="n_label">Hyperproteinemia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:leukoplasia"><data key="n_label">Leukoplasia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:datura-stramonium-l-jimsonweed"><data key="n_label">Jimsonweed</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">JIMSONWEED</data><data key="n_page">426</data><data key="n_scientific">Datura stramonium L.</data><data key="n_safety">X</data><data key="n_safety_raw">X</data><data key="n_dosages">50–100 mg powdered leaf 1–3 ×/day (PH2); 50 mg seed (PH2). Indians apply warmed leaves to the breast to reduce lactation and firm the breast (ZUL).</data><data key="n_downsides">Not covered (AHP). Do not take it (JAD). Commission E reports leaf and seed not permitted for oral use. Contains toxic belladonna alkaloids (AEH). Contraindicated in acute pulmonary edema, glaucoma, paralytic ileus, prostatosis, pyloric stenosis, and tachycardic arrhythmia (PHR). High doses lead to central excitation, compulsive chatter, delirium, hallucination, mania, and restlessness, often followed by exhaustion and lethargy, and/or sleep (CRC; PH2).</data></node>
<node id="ind:aphasia"><data key="n_label">Aphasia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
