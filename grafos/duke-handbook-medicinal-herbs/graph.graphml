<node id="hierba:polygonum-bistorta-l-bistort"><data key="n_label">Bistort</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Persicaria bistorta (L.) Samp.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">BISTORT</data><data key="n_page">77</data><data key="n_scientific">Polygonum bistorta L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1–2 g (PNC); 50–60 g rhizome/liter water for 15–20 minutes (PH2).</data><data key="n_downsides">Class 1 (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD).</data></node>
<node id="act:anipyretic"><data key="n_label">Anipyretic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
