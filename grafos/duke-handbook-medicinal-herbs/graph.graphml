<node id="hierba:atractylodes-macrocephala-koidz-bai-zhu"><data key="n_label">Bai Zhu, Atractylodes</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">BAI ZHU, ATRACTYLODES</data><data key="n_page">51</data><data key="n_scientific">Atractylodes macrocephala Koidz.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">6–12 g (HH3).</data><data key="n_downsides">Class 1 (AHP). LD50 (Decoction) 13,300 mg/kg ipr mouse (HH3).</data></node>
<node id="act:anhidrotic"><data key="n_label">Anhidrotic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
