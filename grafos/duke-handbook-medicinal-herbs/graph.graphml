<node id="hierba:chamaesyce-hypericifolia-spurge"><data key="n_label">Spurge</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">SPURGE</data><data key="n_page">693</data><data key="n_scientific">Chamaesyce hypericifolia (L.) Millsp.</data><data key="n_safety">X</data><data key="n_safety_raw">X</data><data key="n_downsides">“Narcotic. Juice may cause temporary blindness if introduced into the eyes” (CRC).</data></node>
