<node id="act:antitestosterone"><data key="n_label">Antitestosterone</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="ind:polycystic-ovary-syndrome"><data key="n_label">Polycystic Ovary Syndrome</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:systremma"><data key="n_label">Systremma</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:dianthus-chinensis-l-chinese-pink"><data key="n_label">Chinese Pink</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: D. heddewigii hort., D. laciniatus hort. ex Makino. Dianthus superbus is used interchangeably.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE PINK</data><data key="n_page">189</data><data key="n_scientific">Dianthus chinensis L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">4.5–9 g in decoction (FAY).</data><data key="n_downsides">Not covered (AHP; KOM; PH2). Contraindicated in kidney and/or spleen deficiency, and during pregnancy (FAY).</data></node>
<node id="hierba:dichroa-febrifuga-lour-chinese-quinine"><data key="n_label">Chinese Quinine, Fever Flower</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE QUININE, FEVER FLOWER</data><data key="n_page">189</data><data key="n_scientific">Dichroa febrifuga Lour.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_downsides">Not covered (AHP; KOM; PH2). Though 100 times more antimalarial than quinine, gamma (not alpha, as reported in DAA) dichroine can cause diarrhea, GI hypersecretion, hemorrhage, hyperperistalsis, hypotension, tachypnea, and death (DAA). Gamma dichroine is highly emetic, causing hydropic hepatic degeneration. WOI ranks the alkaloids a bit different, re chick malaria; alpha-, beta-, and gamma-dichroine are, respectively, 1, 50, and 100 times as antimalarial as quinine (WOI). Febrifugine is 64 times as powerful. Leaf material shows more antimalarial material than roots., though leaves have lower alkaloid content. Other active principles may lie in the leaves.</data></node>
<node id="act:no-inhibitor"><data key="n_label">NO-Inhibitor</data><data key="n_type">Actividad</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="act:tnf-inhibitor"><data key="n_label">TNF-Inhibitor</data><data key="n_type">Actividad</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:polygala-tenuifolia-willd-chinese-senega-root"><data key="n_label">Chinese Senega Root</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE SENEGA ROOT</data><data key="n_page">189</data><data key="n_scientific">Polygala tenuifolia Willd.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1.5–6 g dry root/day or 3–12 ml fl extract (1:2) (KEB).</data></node>
<node id="ind:fright"><data key="n_label">Fright</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:swertia-chirayita-chirata"><data key="n_label">Chirata</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Gentiana chirata Wall., G. chirayita Roxb. ex Fleming, Swertia chirata (Wall.) C. B. Clarke.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHIRATA</data><data key="n_page">190</data><data key="n_scientific">Swertia chirayita (Roxb. ex Fleming) H. Karst.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">300–2000 mg (HHB); 600–2000 mg (HH3); 14–28 ml tea (with cinnamon and clove) (KAP); 0.5–2 g root in decoction with honey for hiccup or nausea (KAP);10–20 drops 3 ×/day, between meals (PH2).</data><data key="n_downsides">Not covered (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2). Not for patients with duodenal or gastric ulcers (PH2).</data></node>
<node id="hierba:brunfelsia-grandiflora-d-don-chiricsanango"><data key="n_label">Chiricsanango</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHIRICSANANGO</data><data key="n_page">190</data><data key="n_scientific">Brunfelsia grandiflora D. Don.</data><data key="n_safety">X</data><data key="n_safety_raw">X</data><data key="n_downsides">Not covered (AHP; KOM). “Health hazards not known with proper therapeutic dosages” (PH2) (not designated)” (PH2, speaking of B. hopeana). Overdoses may cause death, with anxiety, convulsions, increased cardiac and pulmonary activity, muscle tremors, salivation, spasms, and vomiting (PH2, speaking of B. hopeana). Hallucination accompanied by serious side effects (e.g., chills, cold sweats, heavy tongue, itchiness, nausea, stomachache, temporary insanity, tingling, and vomiting) (DAV). I have experienced alternating chills and fever, numbness, heavy feet, torpor myself.</data></node>
<node id="ind:lymph"><data key="n_label">Lymph</data><data key="n_type">Indicación</data><data key="n_description">Citada en 5 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:allium-schoenoprasum-l-chives"><data key="n_label">Chives</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: A. schoenoprasum var. alpinum DC., Allium sibiricum L.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHIVES</data><data key="n_page">191</data><data key="n_scientific">Allium schoenoprasum L.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">Food farmacy (JAD).</data><data key="n_downsides">Class 1 (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD). Poison to mammals (USDA nomenclature database).</data></node>
<node id="act:hematinic"><data key="n_label">Hematinic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:chlorella-spp-chlorella"><data key="n_label">Chlorella</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHLORELLA</data><data key="n_page">192</data><data key="n_scientific">Chlorella spp.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">2–3 (414 mg) capsules 3 ×/day (APA).</data><data key="n_downsides">Not covered (AHP; KOM; LAF; PHR; SKY; etc.) Largely imported from Asia, this unicellular alga is said to interfere with clotting and augment other anticoagulant activity; one patient taking warfarin experienced clotting irregularities when he took Chlorella. APA reports severe anaphylactic reactions and photodermatosis.</data></node>
<node id="act:photodermatitic"><data key="n_label">Photodermatitic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 3 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="hierba:akebia-quinata-chocolate-vine"><data key="n_label">Chocolate-Vine</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHOCOLATE-VINE</data><data key="n_page">192</data><data key="n_scientific">Akebia quinata (Thunb.) Decne.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">3–9 g in decoction (HH2).</data><data key="n_downsides">Not covered (AHP; KOM). “Health hazards not known with proper therapeutic dosages” (PH2). Overdoses may induce colic, diarrhea, enterosis, and gastrosis. Not for pregnant women (PH2).</data></node>
<node id="ind:galacturia"><data key="n_label">Galacturia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:prunus-virginiana-l-chokecherry"><data key="n_label">Chokecherry, Bitter Berry</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHOKECHERRY, BITTER BERRY</data><data key="n_page">192</data><data key="n_scientific">Prunus virginiana L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data></node>
