<node id="hierba:codonopsis-spp-codonopsis"><data key="n_label">Codonopsis</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CODONOPSIS</data><data key="n_page">207</data><data key="n_scientific">Codonopsis spp.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">Up to 25 g root/day (APA); 30–60 g/day (FAY).</data><data key="n_downsides">Class 1 (AHP).</data></node>
