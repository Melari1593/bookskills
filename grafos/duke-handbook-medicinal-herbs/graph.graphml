<node id="hierba:gardenia-jasminoides-j-ellis-gardenia"><data key="n_label">Gardenia, Cape Jasmine</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: G. augusta Merr., G. florida L., G. radicans Thunb., Warneria augusta L.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">GARDENIA, CAPE JASMINE</data><data key="n_page">318</data><data key="n_scientific">Gardenia jasminoides J. Ellis</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">6–12 g dry fruit (FAY).</data><data key="n_downsides">Class 1 (AHP). Not covered (KOM; PH2).</data></node>
