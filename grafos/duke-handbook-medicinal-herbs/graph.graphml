<node id="hierba:fagus-grandifolia-ehrh-american-beech"><data key="n_label">American Beech</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: F. americana Sweet, F. ferruginea Aiton</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">AMERICAN BEECH</data><data key="n_page">20</data><data key="n_scientific">Fagus grandifolia Ehrh.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1 oz leaf/quart salt water (FAD).</data></node>
