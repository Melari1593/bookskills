<node id="hierba:panax-pseudoginseng-wall-var-notoginseng-tienchi"><data key="n_label">Tienchi</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">TIENCHI</data><data key="n_page">732</data><data key="n_scientific">Panax pseudoginseng Wall. var. notoginseng (Burkill) G. Hoo &amp; C.J. Tseng</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1–3 g powdered root/day (APA); 2–9 g dry root/day or 4–18 ml fluid extract (1:2); higher doses for severe bleeding and trauma (KEB).</data><data key="n_downsides">Class 2b (No reason given) (AHP). Contraindicated in pregnancy (KEB).</data></node>
<node id="act:immunotonic"><data key="n_label">Immunotonic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
