<node id="hierba:luffa-acutangula-angled-loofah"><data key="n_label">Angled Loofah, Chinese Okra</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Cucumis acutangulus L.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">ANGLED LOOFAH, CHINESE OKRA</data><data key="n_page">29</data><data key="n_scientific">Luffa acutangula (L.) Roxb.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1.5–2 g to 10 seed as demulcent (KAP); 5–10 g fruit juice (KAP); 28–56 ml infusion (KAP). LD50 (50% Ethanolic Extract) = 1000 mg/kg ipr mouse (MPI).</data></node>
