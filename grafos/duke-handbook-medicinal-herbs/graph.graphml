<node id="ind:menstruation"><data key="n_label">Menstruation</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:knautia-arvensis-field-scabious"><data key="n_label">Field Scabious</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Scabiosa arvensis L., Trichera arvensis Schrader.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">FIELD SCABIOUS</data><data key="n_page">299</data><data key="n_scientific">Knautia arvensis (L.) Coult.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">4 tsp (3.2 g) in hot tea (MAD); 4 tsp shoot in 2 glasses water/day (PH2).</data><data key="n_downsides">Not covered (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2).</data></node>
<node id="ind:tick"><data key="n_label">Tick</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:ficus-carica-l-fig"><data key="n_label">Fig</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">FIG</data><data key="n_page">300</data><data key="n_scientific">Ficus carica L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">Food farmacy (JAD); 30 g fig syrup (HH3); steep 2 fruits in wine or booze overnight, then eat on an empty stomach for whooping cough (JFM); boil 3 sun-dried leaves for 15 minutes in 300 g water for diabetes (JFM).</data><data key="n_downsides">Not covered (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD). Poultice of dried figs in milk is said to deodorize malignant cancers (KAB).</data></node>
<node id="act:antitumor-prostate"><data key="n_label">Antitumor, prostate</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="act:ascaricide"><data key="n_label">Ascaricide</data><data key="n_type">Actividad</data><data key="n_description">Citada en 13 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="ind:tumor-prostate"><data key="n_label">Tumor, prostate</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:scrophularia-nodosa-l-figwort"><data key="n_label">Figwort</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">FIGWORT</data><data key="n_page">301</data><data key="n_scientific">Scrophularia nodosa L.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">1 tsp (2.8 g) root in hot tea (MAD); 2–8 g herb as tea 3 ×/day (CAN); 2–8 ml liquid herb extract (1:1 in 25% ethanol) (CAN); 4–8 ml liquid herb extract (PNC); 2–4 ml herb tincture (1:10 in 45% ethanol) (CAN).</data><data key="n_downsides">Class 2d. Contraindicated in ventricular tachycardia (AHP; CAN).“Hazards and/or side effects not known for proper therapeutic dosages” (PH2)</data></node>
<node id="ind:caked-breast"><data key="n_label">Caked Breast</data><data key="n_type">Indicación</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:epilobium-angustifolium-l-fireweed"><data key="n_label">Fireweed</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Chamaenerion angustifolium (L.) Scop., Chamerion angustifolium (L.) Holub, Epilobium spicatum Lam.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">FIREWEED</data><data key="n_page">302</data><data key="n_scientific">Epilobium angustifolium L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">Herb taken as a tea (FAD).</data><data key="n_downsides">Class 1 (AHP). Not recorded (PHR).</data><data key="n_extracts">1–2% leaf extract antiinflammatory (WOI). Antiinflammatory tinctures reportedly active against bacteria and yeast (Bacillus subtilis, Candida albicans, Escherichia coli, Mycobacterium smegmatis, Pseudomonas procyanea, Shigella flexneri, Shigella sonnei, Staphylococcus albus, and Staphylococcus aureus) (PHR). Any high-tannin plant can inhibit many enzymes, in vitro, even alpha-reductase, aromatase, elastase, lipoxygenase, and reverse-transcriptase (MAB), but this activity may not be reflected in vivo because of poor availability. Myricetin 3-O-beta-Dglucuronide is 10 × more potent as indomethacin in carageenan-induced edema in the rat paw model (X1775578).</data></node>
<node id="act:alpha-reductase-inhibitor"><data key="n_label">Alpha-Reductase Inhibitor</data><data key="n_type">Actividad</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="act:anti-bph"><data key="n_label">Anti-BPH</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="act:aromatase-inhibitor"><data key="n_label">Aromatase Inhibitor</data><data key="n_type">Actividad</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
