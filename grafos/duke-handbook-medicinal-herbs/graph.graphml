<node id="hierba:thalictrum-foliolosum-dc-asian-meadow-rue"><data key="n_label">Asian Meadow-Rue</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">ASIAN MEADOW-RUE</data><data key="n_page">43</data><data key="n_scientific">Thalictrum foliolosum DC.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">14–28 ml tea (KAP); 1–2 ml root tincture (KAP); 0.5–1 g powder root (KAP). After 6 months storage, berberine was reduced to 1/4 , and magnoflorine to traces (WOI).</data></node>
