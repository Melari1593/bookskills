<node id="ind:trophoblastoma"><data key="n_label">Trophoblastoma</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:leonurus-japonicus-houtt-chinese-motherwort"><data key="n_label">Chinese Motherwort</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: L. artemisia (Lour.) S.Y. Hu, L. heterophyllus Sweet, L. sibiricus auct. pl., Stachys artemisia Lour.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE MOTHERWORT</data><data key="n_page">187</data><data key="n_scientific">Leonurus japonicus Houtt.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">9–30 g herb; 6–9 g seed (FAY); 4–10 g in tea (PH2).</data><data key="n_downsides">Class 2b (AHP). Emmenagogue and uterotonic (AHP). “Health hazards not known with proper therapeutic dosages” (PH2). Overdoses (30 g or more) may generate chest oppression, debility, diaphoresis, dyspnea, and increased sensitivity to pain (PH2).</data></node>
<node id="act:inflammation"><data key="n_label">Inflammation</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="act:spermatogenic"><data key="n_label">Spermatogenic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="ind:embolism"><data key="n_label">Embolism</data><data key="n_type">Indicación</data><data key="n_description">Citada en 8 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:lochiastasis"><data key="n_label">Lochiastasis</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:canarium-vulgare-leenh-chinese-olive"><data key="n_label">Chinese Olive</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: C. commune auct. The herbal PDR takes the easy way out and calls Chinese Olive Canarium species. USDA refers to Chinese Olive as C. vulgare. Some Chinese scholars translate Canarium album to Chinese Olive.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE OLIVE</data><data key="n_page">187</data><data key="n_scientific">Canarium vulgare Leenh.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">Topical ointments using 25% resin are used (PH2).</data><data key="n_downsides">Not covered (AHP; HHB; KOM). “Health hazards not known with proper therapeutic dosages” (PH2). EO reported to cause GI and kidney complaints and hemorrhagic erosion (PH2).</data></node>
<node id="hierba:paeonia-lactiflora-pall-chinese-peony"><data key="n_label">Chinese Peony</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: P. edulis Salisb., P. fragrans Redoute.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHINESE PEONY</data><data key="n_page">188</data><data key="n_scientific">Paeonia lactiflora Pall.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">1 tsp flower/cup water (WIC); 20 g root/750 ml water sipped through the day (APA); Chinese report 3–12 g peony root (FAY); 2–6 g dry root/day or 4–12 ml fluid extract (1:2) (KEB); 6–15 g standardized for paeoniflorin (WHO).</data><data key="n_downsides">Class 1 (P. lactiflora and P. officinalis) (AHP). No peonies were approved by Commission E but they did say, “No risks known” (KOM). The Physicians Desk Reference was a bit more explicit regarding P. officinalis, “Health hazards not known with proper therapeutic dosages” (PH2). “Side effects that may occur, particularly in cases of over dosages, include gastroenterosis with vomiting, colic, and diarrhea” (PHR). Much of the indicated uses and biological activity is attributed to paeoniflorin.</data></node>
<node id="act:antidiaphoretic"><data key="n_label">Antidiaphoretic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 8 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
