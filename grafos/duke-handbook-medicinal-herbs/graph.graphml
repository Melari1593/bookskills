<node id="ind:neck-ache"><data key="n_label">Neck Ache</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="ind:nostalgia"><data key="n_label">Nostalgia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:betula-pumila-l-dwarf-birch"><data key="n_label">Dwarf Birch</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: B. hallii Howell, B. pumila var. fastigiata hort. ex Rehder.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DWARF BIRCH</data><data key="n_page">260</data><data key="n_scientific">Betula pumila L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data></node>
<node id="hierba:sambucus-ebulus-l-dwarf-elder"><data key="n_label">Dwarf Elder</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DWARF ELDER</data><data key="n_page">261</data><data key="n_scientific">Sambucus ebulus L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">2.5 g root/cup water (HHB).</data><data key="n_downsides">Not covered (AHP).“Hazards and/or side effects not recorded for proper therapeutic dosages” (PH2) (but PH2 designates no specific quantified dosage! JAD). Symptoms of poisoning: bloody diarrhea, coma, cyanosis, dizziness, headache, hematchezia, mydriasis, nausea, oral pain, or vomiting (HHB; MAD; PH2). “Cases of death are also mentioned” (PH2). Saponin diuretic (HHB). Aqueous extracts hypotensive (ipr rat) (HH2).</data></node>
<node id="ind:cancer-flesh"><data key="n_label">Cancer, flesh</data><data key="n_type">Indicación</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:malva-pusilla-sm-dwarf-mallow"><data key="n_label">Dwarf Mallow</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: M. borealis Wallman, M. rotundifolia L.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DWARF MALLOW</data><data key="n_page">261</data><data key="n_scientific">Malva pusilla Sm.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data></node>
<node id="ind:glycosuria"><data key="n_label">Glycosuria</data><data key="n_type">Indicación</data><data key="n_description">Citada en 5 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:genista-tinctoria-l-dyers-broom"><data key="n_label">Dyer’S Broom</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Genista patula M. Bieb.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DYER’S BROOM</data><data key="n_page">261</data><data key="n_scientific">Genista tinctoria L.</data><data key="n_safety">X</data><data key="n_safety_raw">X</data><data key="n_dosages">2 tsp/day in hot tea (MAD); 1 tsp herb/cup, 1–2 cups/day (PHR; PH2); tinctures used for gravel and stone (MAD).</data><data key="n_downsides">Class 2b (AHP). “Hazards and/or side effects not recorded for proper therapeutic dosages” (PH2). Overdoses can cause diarrhea (PH2). Not for use by pregnant women (PH2).</data></node>
<node id="ind:hip-ache"><data key="n_label">Hip Ache</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:isatis-tinctoria-l-dyers-woad"><data key="n_label">Dyer’S Woad</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">DYER’S WOAD</data><data key="n_page">262</data><data key="n_scientific">Isatis tinctoria L.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">2–3 g/day powdered leaf or root (AKT).</data><data key="n_downsides">Class 1 (AHP). Not covered (KOM; PH2).</data></node>
<node id="act:antidermatophytic"><data key="n_label">Antidermatophytic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
