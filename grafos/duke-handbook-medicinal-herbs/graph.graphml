<node id="ind:bilharzia"><data key="n_label">Bilharzia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 4 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:erythroxylum-coca-lam-coca"><data key="n_label">Coca</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">COCA</data><data key="n_page">204</data><data key="n_scientific">Erythroxylum coca Lam.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">Individual dose, 3 g dry leaf (HHB). Maximum individual dose 30 mg cocaine (HHB).</data><data key="n_downsides">Not covered (AHP). Classified as a drug, which, normally, must be registered as a pharmaceutical specialty (AEH). Embryotoxic, cocaine passes into the fetus and mother’s milk (PHR). In high doses it may paralyze motor neuron fibers (PH2).</data></node>
<node id="act:psychedelic"><data key="n_label">Psychedelic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 7 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="ind:altitude-sickness"><data key="n_label">Altitude Sickness</data><data key="n_type">Indicación</data><data key="n_description">Citada en 10 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:guarea-rusbyi-cocillana"><data key="n_label">Cocillana</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">COCILLANA</data><data key="n_page">205</data><data key="n_scientific">Guarea rusbyi (Britton) Rusby</data><data key="n_safety">+</data><data key="n_safety_raw">+</data><data key="n_dosages">0.5–1 g bark 3 ×/day (HHB; HH2); 1.3–3 g for amenorrhea (HH2).</data><data key="n_downsides">Not covered (AHP).“Health hazards not known with proper therapeutic dosages” (PH2). Large doses cause diarrhea, fatigue, and nausea (HHB; PH2).</data></node>
<node id="hierba:celosia-argentea-l-var-cristata-cockscomb"><data key="n_label">Cockscomb</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: C. cristata L. Foster and Yue treat flowers of C. cristata (cockscomb) as Ji Guan Hua + (Pinyin) and seeds of C. argentea (redfox) as Qing Xiang Zi (Pinyin). All species of the genus are also called woolflower (FAY).</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">COCKSCOMB</data><data key="n_page">205</data><data key="n_scientific">Celosia argentea L. var. cristata (L.) Kuntze</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">4–15 g fl (FAY); 3–15 g seed in decoction (FAY).</data><data key="n_downsides">Not covered (AHP; KOM; PH2). Leaves not to be eaten by menstruating women (LMP).</data></node>
<node id="act:uti"><data key="n_label">UTI</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
<node id="ind:irosis"><data key="n_label">Irosis</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:cocos-nucifera-l-coconut"><data key="n_label">Coconut</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">COCONUT</data><data key="n_page">206</data><data key="n_scientific">Cocos nucifera L.</data><data key="n_safety">+++</data><data key="n_safety_raw">+++</data><data key="n_dosages">Food farmacy (JAD). Four spoons of ginger in coconut water is an emmenagogue (JFM).</data><data key="n_downsides">Not covered (AHP). None listed (PH2). “Health hazards not known when used as a food” (PH2). Coconut meat is hard to digest and may cause dyspepsia. The emmenagogue reports, sketchy though they are, may indicate caution among pregnant women (JAD). Extracts of the shell fibers showed NO antimicrobial activities (MPI).</data></node>
<node id="act:antiblennorrhagic"><data key="n_label">Antiblennorrhagic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
