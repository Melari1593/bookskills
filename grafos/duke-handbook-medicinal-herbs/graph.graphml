<node id="hierba:tephrosia-virginiana-catgut"><data key="n_label">Catgut</data><data key="n_type">Hierba</data><data key="n_description">Sinónimos: Cracca virginiana L.</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CATGUT</data><data key="n_page">163</data><data key="n_scientific">Tephrosia virginiana (L.) Pers.</data><data key="n_safety">+</data><data key="n_safety_raw">+</data></node>
<node id="hierba:nepeta-cataria-l-catnip"><data key="n_label">Catnip</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CATNIP</data><data key="n_page">164</data><data key="n_scientific">Nepeta cataria L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1–2 tsp fresh herb (PED); 0.5–1 g dry herb (PED); 2–4 g dry herb (PNC); 1–2 tsp dry herb/cup water up to 3 ×/day (SKY); 2 tsp herb/cup water to 3 ×/day (APA); 10 tsp herb/liter, 2–3 cups/day (PHR; PH2); 0.5–1 tsp tincture up to 3 ×/day (APA); 5 ml tincture 3 ×/day (children with cough) (SKY).</data><data key="n_downsides">Class 2b (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2). Emmenagogues should be avoided in pregnancy. As a mild uterine stimulant, avoid in pregnancy (PH2; WAM). An important source of the COX-2-Inhibitor, ursolic-acid (COX).</data></node>
<node id="act:cholecotropic"><data key="n_label">Cholecotropic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
