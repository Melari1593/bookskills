<node id="ind:chlamydia"><data key="n_label">Chlamydia</data><data key="n_type">Indicación</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
