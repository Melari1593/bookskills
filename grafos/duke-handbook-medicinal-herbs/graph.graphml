<node id="hierba:helleborus-niger-l-christmas-rose"><data key="n_label">Christmas Rose, Black Hellebore</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CHRISTMAS ROSE, BLACK HELLEBORE</data><data key="n_page">193</data><data key="n_scientific">Helleborus niger L.</data><data key="n_safety">X</data><data key="n_safety_raw">X</data><data key="n_dosages">Dangerous (JAD). 50-mg root or rhizome; maximum single dose 200 mg; largest daily dose 1000 mg (HHB; HH2; PHR); 250–1000 mg powdered root (MAD).</data></node>
<node id="act:longevigenic"><data key="n_label">Longevigenic</data><data key="n_type">Actividad</data><data key="n_description">Citada en 1 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
