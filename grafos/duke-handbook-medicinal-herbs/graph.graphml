<node id="ind:trichomonas"><data key="n_label">Trichomonas</data><data key="n_type">Indicación</data><data key="n_description">Citada en 3 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Indications</data></node>
<node id="hierba:lycopodium-clavatum-l-clubmoss"><data key="n_label">Clubmoss</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">CLUBMOSS</data><data key="n_page">202</data><data key="n_scientific">Lycopodium clavatum L.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_dosages">1.5 herb (HHB); 1–5 g powder/day (MAD); 2–3 cups tea/day (PH2).</data><data key="n_downsides">Not covered (AHP). “Hazards and/or side effects not known for proper therapeutic dosages” (PH2). Large doses are emetic (MAD).</data></node>
<node id="act:gastrosedative"><data key="n_label">Gastrosedative</data><data key="n_type">Actividad</data><data key="n_description">Citada en 2 monografías</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">Activities</data></node>
