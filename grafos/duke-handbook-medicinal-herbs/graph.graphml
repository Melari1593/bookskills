<node id="hierba:guazuma-ulmifolia-lam-bastard-cedar"><data key="n_label">Bastard Cedar</data><data key="n_type">Hierba</data><data key="n_source">Duke JA et al. Handbook of Medicinal Herbs, 2nd ed. CRC Press, 2002</data><data key="n_chapter">Catalog of Herbs (A to Z)</data><data key="n_section">BASTARD CEDAR</data><data key="n_page">62</data><data key="n_scientific">Guazuma ulmifolia Lam.</data><data key="n_safety">++</data><data key="n_safety_raw">++</data><data key="n_extracts">Leaves contain 21,700 ppm caffeine (TRA). Nontoxic; LD50 = &gt;25,000 mg/kg orl rat; LD50 = 5975 mg/kg ipr rat.</data></node>
