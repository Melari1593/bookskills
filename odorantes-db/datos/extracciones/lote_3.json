{
 "estudios": [
  {"doi": "10.1016/j.foodchem.2020.127721", "pmid": "32763731", "pmcid": null, "autor": "Zhang", "anio": 2020,
   "alimento": "frambuesa", "muestra": "Zumo clarificado de frambuesa roja (Rubus idaeus cv. Heritage)",
   "metodos": ["AEDA", "OAV", "recombinacion", "GC-MS"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Combinó frecuencia de detección y AEDA para hallar 31 odorantes del zumo; 14 superaron OAV 1. La β-ionona fue la más potente por OAV y FD. Un modelo recombinado reprodujo las notas herbácea, floral, leñosa y acaramelada."},
  {"doi": "10.1021/jf0498721", "pmid": "15291490", "pmcid": null, "autor": "Klesk", "anio": 2004,
   "alimento": "frambuesa", "muestra": "Frambuesa roja fresca cv. Meeker de Oregón y de Washington (EE. UU.)",
   "metodos": ["AEDA", "GC-MS"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Aplicó AEDA a frambuesas Meeker de dos regiones e identificó 75 odorantes, varios de forma tentativa. Veintiuno tuvieron impacto equivalente en ambos orígenes; otros variaron de FD según la región."},
  {"doi": "10.3390/plants15111639", "pmid": "42280675", "pmcid": "PMC13258824", "autor": "Nunnally-Martínez", "anio": 2026,
   "alimento": "frambuesa", "muestra": "Frambuesa roja fresca, tres líneas de mejora (RF-055, RF-060, RF-076) cultivadas en invernadero en Huelva, España; fruto maduro",
   "metodos": ["OAV", "GC-MS"],
   "texto_completo": true, "licencia": "CC BY 4.0",
   "nota": "Midió de forma semicuantitativa los volátiles C6 de hoja verde por HS-SPME-GC-MS en bayas de Rosaceae. En frambuesa madura, el 3-hexenal y otros aldehídos herbáceos dominaron los OAV estimados; los ésteres C6 aportaron notas frutales menores. Sin olfatometría."},

  {"doi": "10.1016/j.foodchem.2026.151051", "pmid": "42748703", "pmcid": null, "autor": "Xu", "anio": 2026,
   "alimento": "fresa", "muestra": "Fresa fresca cv. 'Jingxiang' (China), estadio rojo completo",
   "metodos": ["AEDA", "GC-MS"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Usó SPME y SAFE con GC-O-QTOF en cinco estadios de maduración. En fruto rojo halló 64 odorantes; el furaneol tuvo el FD máximo y los ésteres dominaron. Las notas verdes del fruto inmaduro dieron paso a notas dulces y frutales."},
  {"doi": "10.1021/jf2030924", "pmid": "22026593", "pmcid": null, "autor": "Du", "anio": 2011,
   "alimento": "fresa", "muestra": "Fresa fresca cv. 'Strawberry Festival' y 'Florida Radiance', cultivo subtropical de invierno (Florida, EE. UU.)",
   "metodos": ["OAV", "GC-MS"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Combinó GC-O tiempo-intensidad, cuantificación por GC-MS y OAV con un panel descriptivo. Detectó 30 zonas olfativas y 22 compuestos con OAV mayor que 1; butanoato de etilo y furaneol encabezaron los OAV en 'Strawberry Festival'."},
  {"doi": "10.1016/j.foodchem.2025.145619", "pmid": "40714502", "pmcid": null, "autor": "Yao", "anio": 2025,
   "alimento": "fresa", "muestra": "Zumo de fresa fresco y esterilizado térmicamente a distintos tiempos",
   "metodos": ["OAV", "recombinacion", "omision", "GC-MS"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Comparó zumos esterilizados por calor con GC-IMS, GC-MS-O y OAV; definió 18 odorantes clave. El calor redujo ésteres y aldehídos frescos. Recombinación y omisión confirmaron tres compuestos como causa del mal sabor térmico."},

  {"doi": "10.1021/acs.jafc.6b00822", "pmid": "27167034", "pmcid": null, "autor": "Munafo", "anio": 2016,
   "alimento": "mango", "muestra": "Mango madurado en árbol, cv. Haden",
   "metodos": ["SIDA", "OAV", "recombinacion", "omision"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Cuantificó por dilución isotópica 34 odorantes con FD alto de un AEDA previo; 24 tuvieron OAV mayor que 1, encabezados por ésteres etílicos y un undecatrieno. Un modelo de 15 compuestos a concentración natural reprodujo el aroma del fruto."},
  {"doi": "10.1021/jf5008743", "pmid": "24766361", "pmcid": null, "autor": "Munafo", "anio": 2014,
   "alimento": "mango", "muestra": "Mango madurado en árbol, cv. Haden, White Alfonso, Praya Sowoy, Royal Special y Malindi",
   "metodos": ["AEDA"],
   "texto_completo": false, "licencia": "sin datos",
   "nota": "Aplicó AEDA comparativo tras extracción con disolvente y SAFE a cinco cultivares; encontró 54 odorantes con FD de 4 a 2048 o más. El furaneol destacó en todos; las diferencias de FD explican perfiles distintos por cultivar."},
  {"doi": "10.3390/foods9010075", "pmid": "31936596", "pmcid": "PMC7023010", "autor": "Liu", "anio": 2020,
   "alimento": "mango", "muestra": "Pulpa de mango maduro de cinco cultivares chinos (Jinmang, Qingmang, Guifei, Hongyu, Tainong), mercado de Guangzhou",
   "metodos": ["OAV", "GC-MS"],
   "texto_completo": true, "licencia": "CC BY 4.0",
   "nota": "Analizó pulpa por HS-SPME-GC-MS con olfatometría (frecuencia de detección e intensidad) y OAV con patrones auténticos. Señaló 29 odorantes activos; terpenos y aldehídos dominaron, con γ-terpineno, nonanal y hexanal entre los OAV más altos."}
