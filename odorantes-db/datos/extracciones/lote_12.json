{
 "estudios": [
  {"doi": "10.1515/znc-2017-0087", "pmid": "29145172", "pmcid": null, "autor": "Sandner", "anio": 2018, "alimento": "canela",
   "muestra": "Botones de Cinnamomum cassia del mercado alemán, extracto Soxhlet",
   "metodos": ["AEDA", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Extractos de botones de cassia analizados por GC-olfatometría. El cinamaldehído dominó en cantidad y tuvo el mayor factor de dilución; 2-feniletanol y alcohol cinamílico también contribuyeron. La cumarina fue baja en estos botones."},
  {"doi": "10.1016/j.foodres.2024.115446", "pmid": "39779079", "pmcid": null, "autor": "Xing", "anio": 2025, "alimento": "canela",
   "muestra": "Extractos de aceite de corteza de canela",
   "metodos": ["OAV", "GC-MS", "GC-O"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Compararon extractos de aceite de corteza con SPME-GC-MS, OAV y olfatometría. Siete compuestos resultaron clave, entre ellos cinamaldehído, cumarina, benzaldehído y cinamato de etilo."},
  {"doi": "10.1016/j.jep.2026.122073", "pmid": "42314810", "pmcid": null, "autor": "Yang", "anio": 2026, "alimento": "clavo",
   "muestra": "Revisión del clavo (botón floral seco)",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Revisión de usos, química y control de calidad del clavo. El aceite volátil es sobre todo eugenol, 15-20 % del clavo; la farmacopea china exige al menos 11 %. No mide actividad de olor."},
  {"doi": "pmid:26434138", "pmid": "26434138", "pmcid": null, "autor": "Chatterjee", "anio": 2015, "alimento": "nuez_moscada",
   "muestra": "Aceites esenciales de nuez moscada por varias técnicas de extracción",
   "metodos": ["GC-O", "OAV", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Compararon aceites obtenidos por distintas extracciones. La olfatometría y el OAV señalaron al sabineno y al alfa-pineno como responsables del olor típico de la nuez moscada; el beta-pineno también aportó."},
  {"doi": "10.1021/jf800183k", "pmid": "18461961", "pmcid": null, "autor": "Wood", "anio": 2008, "alimento": "pimienta_negra",
   "muestra": "Uvas y vino Shiraz y pimienta negra",
   "metodos": ["OAV", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Identificaron la rotundona como el compuesto del carácter a pimienta en vino y en la especia. En pimienta su OAV está entre 50 000 y 250 000. Una parte de las personas no la percibe."},
  {"doi": "10.1007/s13197-016-2258-0", "pmid": "27478239", "pmcid": null, "autor": "Sharma", "anio": 2016, "alimento": "comino",
   "muestra": "Semillas de dos genotipos de comino, molienda convencional y criogénica",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Estudio de composición del aceite esencial. El cuminaldehído fue el componente principal y subió con la molienda criogénica. Sin olfatometría."},
  {"doi": "10.3390/molecules29040844", "pmid": "38398596", "pmcid": null, "autor": "Pater", "anio": 2024, "alimento": "cilantro_semilla",
   "muestra": "Cerveza de trigo baja en alcohol con semilla de cilantro añadida en distintas etapas",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Midieron terpenos de la semilla en cerveza. Añadirla en la fermentación dio más linalol, alcanfor y gamma-terpineno; en el hervor, más mirceno, limoneno y geraniol. Matriz de cerveza, sin olfatometría."},
  {"doi": "10.3390/metabo11010021", "pmid": "33396947", "pmcid": null, "autor": "Chen", "anio": 2020, "alimento": "curcuma",
   "muestra": "Rizoma fresco de Curcuma amada (3 accesiones) y C. longa (1), Myanmar",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "SPME con GC-TOF-MS en rizoma fresco. Los volátiles más abundantes fueron sesquiterpenos como ar-turmerona y alfa-zingibereno. La mayoría de muestras era C. amada, no la cúrcuma común."},
  {"doi": "10.1021/acs.jafc.7b00559", "pmid": "28393526", "pmcid": null, "autor": "Pang", "anio": 2017, "alimento": "jengibre",
   "muestra": "Rizoma de jengibre, extracto SAFE y espacio de cabeza",
   "metodos": ["AEDA", "GC-O", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "AEDA y dilución del espacio de cabeza. Geranial, eucaliptol, linalol y acetato de bornilo tuvieron el mayor factor de dilución; en el espacio de cabeza dominaron alfa-pineno y eucaliptol."},
  {"doi": "10.1007/s13197-022-05560-8", "pmid": "36276529", "pmcid": null, "autor": "Mishra", "anio": 2022, "alimento": "cardamomo",
   "muestra": "Cardamomo verde (Elettaria cardamomum) secado a tres temperaturas",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Siguieron el aroma durante el secado. El acetato de alfa-terpinilo y el 1,8-cineol fueron los compuestos principales del fruto seco. Sin olfatometría."},
  {"doi": "10.3389/fnut.2022.1027605", "pmid": "36704799", "pmcid": null, "autor": "Zhang", "anio": 2022, "alimento": "aji",
   "muestra": "Ají verde arrugado (Capsicum annuum), 19 variedades del noroeste de China",
   "metodos": ["OAV", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Calidad del fruto y compuestos activos en aroma de 19 variedades. La 2-isobutil-3-metoxipirazina fue el principal contribuyente al aroma."},
  {"doi": "10.1039/d4ra02343a", "pmid": "38769966", "pmcid": null, "autor": "Luo", "anio": 2024, "alimento": "aji",
   "muestra": "Salsa de ají frito con distintos pretratamientos",
   "metodos": ["GC-O", "OAV", "GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Análisis sensorial, olfatometría y rOAV de salsas de ají frito. Once compuestos resultaron clave, entre aldehídos de Strecker, metional, eucaliptol, linalol y decadienales."},
  {"doi": "10.3390/ph17010064", "pmid": "38256897", "pmcid": null, "autor": "Monzote", "anio": 2023, "alimento": "pimienta_de_olor",
   "muestra": "Aceite esencial de Pimenta dioica",
   "metodos": ["GC-MS"], "texto_completo": false, "licencia": "sin datos",
   "nota": "Estudio antileishmania con composición del aceite. El eugenol fue el compuesto más abundante, cerca del 80 %. Sin olfatometría."}
